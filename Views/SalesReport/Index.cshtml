@model MIEL.web.Models.ViewModel.SalesReportVM
@{
    Layout = "_AdminLayout";
}

<style>
    .invoice-box {
        border: 1px solid #000;
        background: #fff;
    }

    .invoice-box .row {
        margin-left: 0;
        margin-right: 0;
    }

    @@media print {
        body * {
            visibility: hidden;
        }

        #printArea, #printArea * {
            visibility: visible;
        }

        #printArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }
    }
</style>

<div class="container-fluid mt-4">

    <div class="card shadow-sm border-0">

        <!-- Header -->
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Sales Report</h5>
        </div>

        <div class="card-body">

            <!-- FILTER -->
            <form method="get">
                <div class="row g-3 align-items-end">

                    <div class="col-md-2">
                        <label>From Date</label>
                        <input type="date" name="fromDate"
                               value="@Model.FromDate?.ToString("yyyy-MM-dd")"
                               class="form-control" />
                    </div>

                    <div class="col-md-2">
                        <label>To Date</label>
                        <input type="date" name="toDate"
                               value="@Model.ToDate?.ToString("yyyy-MM-dd")"
                               class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label>Customer</label>
                        <select name="customerId" class="form-select">
                            <option value="">-- Select Customer --</option>
                            @foreach (var c in Model.Customers)
                            {
                                <option value="@c.CustomerId"
                                        selected="@(Model.CustomerId == c.CustomerId)">
                                    @c.FirstName @c.LastName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label>Sales Mode</label>
                        <select name="salesMode" class="form-select">
                            <option value="">-- All --</option>
                            <option value="2" selected="@(Model.SalesMode == 2)">Online</option>
                            <option value="1" selected="@(Model.SalesMode == 1)">Offline</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label>Payment Type</label>
                        <select name="paymentType" class="form-select">
                            <option value="">-- All --</option>
                            <option value="Cash" selected="@(Model.PaymentType == "Cash")">Cash</option>
                            <option value="PayID" selected="@(Model.PaymentType == "PayID")">PayID</option>
                        </select>
                    </div>

                    <div class="col-md-1 d-grid">
                        <button id="btnShowReport" type="submit" class="btn btn-primary">
                            @(Model.Results != null && Model.Results.Any() ? "Hide Report" : "Search")
                        </button>
                    </div>

                    <div class="col-md-1 d-grid">
                        <button type="button" onclick="printReport()" class="btn btn-success">
                            Print
                        </button>
                    </div>

                    <div class="col-md-1 d-grid">
                        <a href="@Url.Action("Export", "SalesReport", new {
                            fromDate = Model.FromDate?.ToString("yyyy-MM-dd"),
                            toDate = Model.ToDate?.ToString("yyyy-MM-dd"),
                            customerId = Model.CustomerId,
                            salesMode = Model.SalesMode,
                            paymentType = Model.PaymentType
                        })"
                           class="btn btn-warning">
                            Export
                        </a>
                    </div>

                    <div class="col-md-1 d-grid">
                        <a href="@Url.Action("Index", "SalesReport")"
                           class="btn btn-outline-secondary">
                            Clear
                        </a>
                    </div>

                </div>
            </form>

            <hr />

            <!-- REPORT AREA -->
            <div id="printArea">
                @if (Model.Results != null && Model.Results.Any())
                {
                    <!-- TITLE -->
                    <div class="text-center mb-2">
                        <h5 class="fw-bold">Sales Detail Report</h5>
                        <hr />
                    </div>

                    foreach (var invoice in Model.Results)
                    {
                        <div class="invoice-box mb-4 p-3">
                            <!-- HEADER -->
                            <div class="row mb-2">
                                <div class="col-md-6">
                                    <strong>Invoice No:</strong> @invoice.InvoiceNo <br />
                                    <strong>Date:</strong> @invoice.SalesDate.ToString("dd-MM-yyyy")
                                </div>
                                <div class="col-md-6 text-end">
                                    <strong>Customer:</strong> @invoice.CustomerName
                                </div>
                            </div>

                            <!-- COLUMN HEADER -->
                            <div class="row fw-bold border-bottom pb-1">
                                <div class="col-md-5">Product</div>
                                <div class="col-md-3">Batch</div>
                                <div class="col-md-4 text-end">Amount</div>
                            </div>

                            <!-- ITEMS -->
                            @foreach (var item in invoice.Items)
                            {
                                <div class="row py-1">
                                    <div class="col-md-5">@item.ProductName</div>
                                    <div class="col-md-3">@item.BatchNumber</div>
                                    <div class="col-md-4 text-end"></div>
                                </div>
                            }

                            <!-- TOTAL -->
                            <div class="row border-top pt-2 mt-2 fw-bold">
                                <div class="col-md-8 text-end">Total:</div>
                                <div class="col-md-4 text-end">
                                    @invoice.NetAmount.ToString("N2")
                                </div>
                            </div>
                        </div>
                    }
                }
                else if (ViewBag.IsInitialLoad == true)
                {
                    <!-- Clean state on load -->
                }
                else
                {
                    <div class="text-center text-muted">No records found</div>
                }
            </div>

        </div>
    </div>

</div>

@section Scripts{
<script>
    function printReport() {
        window.print();
    }

    document.addEventListener("DOMContentLoaded", function () {
        const btnShowReport = document.getElementById("btnShowReport");
        const printArea = document.getElementById("printArea");

        if (btnShowReport && printArea) {
            btnShowReport.addEventListener("click", function (e) {
                // Determine if results are currently visible in the DOM
                const hasResults = printArea.querySelector(".invoice-box") !== null;
                
                if (hasResults && btnShowReport.innerText.includes("Hide Report")) {
                    printArea.style.display = "none";
                    btnShowReport.innerText = "Show Report";
                    e.preventDefault();
                } else if (printArea.style.display === "none") {
                    printArea.style.display = "block";
                    btnShowReport.innerText = "Hide Report";
                    e.preventDefault();
                }
            });
        }
    });
</script>
}