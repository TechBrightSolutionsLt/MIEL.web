@model MIEL.web.Models.ViewModel.SalesReportVM
@{
    Layout = "_AdminLayout";
}

<style>
    .report-card {
        border: 1px solid #e0e4e8;
        border-radius: 12px;
        padding: 30px;
        margin-bottom: 40px;
        background: #fff;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        position: relative;
    }

    .report-header-info {
        background-color: #fdfdfd;
        padding: 15px 20px;
        border-radius: 8px;
        margin-bottom: 25px;
        border-left: 5px solid #c9ab82;
        border-bottom: 1px solid #f0f0f0;
    }

    .info-label {
        font-weight: 500;
        color: #777;
        font-size: 0.85rem;
        display: block;
        margin-bottom: 2px;
    }

    .info-value {
        font-weight: 700;
        color: #222;
        font-size: 0.95rem;
    }

    .report-table thead th {
        background-color: #fafbfc;
        border-top: 1px solid #eee !important;
        border-bottom: 2px solid #eee !important;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 0.8px;
        padding: 12px 8px;
        color: #555;
    }
    
    .report-table tbody td {
        padding: 12px 8px;
        vertical-align: middle;
        border-bottom: 1px solid #f9f9f9;
        font-size: 0.88rem;
        color: #333;
    }

    .totals-row {
        background-color: #fcfcfc;
        font-weight: 700;
        border-top: 2px solid #eee;
    }

    .card-footer-summary {
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #f0f0f0;
        display: flex;
        justify-content: flex-end;
        gap: 40px;
    }

    .summary-item {
        text-align: right;
    }

    .main-title {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-weight: 800;
        letter-spacing: 1.5px;
        color: #1a1a1a;
    }

    @@media print {
        #printArea { padding: 0 !important; visibility: visible !important; position: static !important; }
        .report-card {
            border: 1px solid #dee2e6;
            box-shadow: none;
            margin-bottom: 30px;
            padding: 20px;
            break-inside: avoid;
        }
        .no-print { display: none !important; }
        .report-header-info {
            background-color: #f8f9fa !important;
            -webkit-print-color-adjust: exact;
            border-left: 5px solid #c9ab82 !important;
        }
        table { width: 100% !important; }
        th, td { border: 1px solid #eee !important; padding: 6px !important; }
    }
</style>

<div class="container-fluid mt-4">

    <!-- Modern Filter Section -->
    <div class="card shadow-sm border-0 mb-5 no-print" style="border-radius: 15px; background: #fff;">
        <div class="card-body p-4">
            <div class="d-flex align-items-center mb-3">
                <h4 class="mb-0 fw-bold" style="color: #333; font-size: 24px;">Sales Detail Report</h4>
            </div>

            <form method="get">
                <div class="row g-3">
                    <!-- Checkboxes Row -->
                    <div class="col-12 d-flex gap-4 mb-2">
                        <div class="form-check">
                            <input class="form-check-input mt-1" type="checkbox" checked disabled>
                            <label class="form-check-label fw-bold" style="font-size: 13px;">Sales Date</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input mt-1" type="checkbox">
                            <label class="form-check-label fw-bold" style="font-size: 13px;">Invoice No</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input mt-1" type="checkbox">
                            <label class="form-check-label fw-bold" style="font-size: 13px;">Customer</label>
                        </div>
                    </div>

                    <!-- Inputs Row -->
                    <div class="col-md-3">
                        <div class="d-flex gap-2">
                           <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control px-2" style="background: #f8f9fa; border: 1px solid #dee2e6; color: #666;" />
                           <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control px-2" style="background: #f8f9fa; border: 1px solid #dee2e6; color: #666;" />
                        </div>
                    </div>

                    <div class="col-md-3">
                        <input type="text" class="form-control" placeholder="Enter Invoice No" style="background: #e9ecef; border: 1px solid #dee2e6;" disabled />
                    </div>

                    <div class="col-md-3">
                        <select name="customerId" class="form-select" style="background: #e9ecef; border: 1px solid #dee2e6; color: #666;">
                            <option value="">-- All Customers --</option>
                            @foreach (var c in Model.Customers)
                            {
                                <option value="@c.CustomerId" selected="@(Model.CustomerId == c.CustomerId)">@c.FirstName @c.LastName</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3 d-flex gap-2 align-items-start">
                        <button id="btnShowReport" type="submit" class="btn text-white px-4 shadow-sm w-100 py-2 d-flex align-items-center justify-content-center gap-2" style="background-color: #c99c92; border: none; border-radius: 8px; font-weight: 500;">
                            <i class="fas fa-search"></i> @(Model.Results != null && Model.Results.Any() ? "Hide Report" : "Show Report")
                        </button>
                        <a href="@Url.Action("Index", "SalesReport")" class="btn btn-white border px-4 py-2" style="border-radius: 8px; color: #666; background: #fff; border-color: #ced4da;">Reset</a>
                    </div>
                </div>
            </form>

            <div class="d-flex justify-content-end gap-3 mt-4">
                 <a href="@Url.Action("Export", "SalesReport", new {
                    fromDate = Model.FromDate?.ToString("yyyy-MM-dd"),
                    toDate = Model.ToDate?.ToString("yyyy-MM-dd"),
                    customerId = Model.CustomerId,
                    salesMode = Model.SalesMode,
                    paymentType = Model.PaymentType
                })" class="btn text-white px-4 py-2 shadow-sm d-flex align-items-center gap-2" style="background-color: #198754; border: none; border-radius: 8px;">
                    <i class="fas fa-file-excel"></i> Export Excel
                </a>
                <button type="button" onclick="window.print()" class="btn px-4 py-2 shadow-sm d-flex align-items-center gap-2 text-white" style="background-color: #c9ab82; border: none; border-radius: 8px;">
                   <i class="fas fa-print"></i> Print Report
                </button>
            </div>
        </div>
    </div>

    <!-- REPORT AREA -->
    <div id="printArea">
        @if (Model.Results != null && Model.Results.Any())
        {
            <div class="text-center mb-5">
                <h1 class="main-title text-uppercase mb-1">Sales Detail Report</h1>
                <div class="text-muted fw-bold">Generated on @DateTime.Now.ToString("dd MMMM yyyy")</div>
                <hr style="width: 80px; border: 3px solid #c9ab82; margin: 20px auto; opacity: 1;"/>
            </div>

            @foreach (var sale in Model.Results)
            {
                <div class="report-card">
                    <!-- Invoice Info -->
                    <div class="report-header-info">
                        <div class="row">
                            <div class="col-md-3">
                                <span class="info-label">Invoice No:</span>
                                <span class="info-value">@sale.InvoiceNo</span>
                            </div>
                            <div class="col-md-3">
                                <span class="info-label">Sales Date:</span>
                                <span class="info-value">@sale.SalesDate.ToString("dd-MMM-yyyy")</span>
                            </div>
                            <div class="col-md-4">
                                <span class="info-label">Customer:</span>
                                <span class="info-value">@sale.CustomerName</span>
                            </div>
                           
                        </div>
                    </div>

                    <!-- Items Table -->
                    <div class="table-responsive">
                        <table class="table table-borderless report-table mb-0" style="table-layout: fixed; width: 100%;">
                            <thead>
                                <tr>
                                    <th style="width: 15%;">ITEM NAME</th>
                                    <th style="width: 15%;">BATCH NO</th>
                                    <th style="width: 6%;" class="text-end">QTY</th>
                                    <th style="width: 10%;" class="text-end">RATE</th>
                                    <th style="width: 10%;" class="text-end">NET AMT</th>
                                    <th style="width: 10%;" class="text-end">DISCOUNT</th>
                                    <th style="width: 12%;" class="text-end">TAXABLE</th>
                                    <th style="width: 10%;" class="text-end">TAX</th>
                                    <th style="width: 12%;" class="text-end">TOTAL</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in sale.Items)
                                {
                                    <tr>
                                        <td class="fw-bold">@item.ProductName</td>
                                        <td>@item.BatchNumber</td>
                                        <td class="text-end">@item.Quantity.ToString("F2")</td>
                                        <td class="text-end">@item.Rate.ToString("F2")</td>
                                        <td class="text-end">@item.NetAmt.ToString("F2")</td>
                                        <td class="text-end text-danger">-@item.Discount.ToString("F2")</td>
                                        <td class="text-end">@item.Taxable.ToString("F2")</td>
                                        <td class="text-end">@item.Tax.ToString("F2")</td>
                                        <td class="text-end fw-bold">@((item.Taxable + item.Tax).ToString("F2"))</td>
                                    </tr>
                                }
                                <tr class="totals-row">
                                    <td colspan="2" class="text-end fw-bold text-uppercase">Totals</td>
                                    <td class="text-end fw-bold">@sale.Items.Sum(x => x.Quantity).ToString("F2")</td>
                                    <td></td>
                                    <td class="text-end fw-bold">@sale.TotalNetAmt.ToString("F2")</td>
                                    <td class="text-end fw-bold text-danger">@sale.TotalDiscount.ToString("F2")</td>
                                    <td class="text-end fw-bold">@sale.TotalTaxable.ToString("F2")</td>
                                    <td class="text-end fw-bold">@sale.TotalTax.ToString("F2")</td>
                                    <td class="text-end fw-bold">@sale.GrandTotal.ToString("F2")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Footer Summary -->
                    <div class="card-footer-summary">
                        <div class="summary-item">
                            <span class="info-label">Invoice Taxable:</span>
                            <span class="info-value">@sale.TotalTaxable.ToString("F2")</span>
                        </div>
                        <div class="summary-item">
                            <span class="info-label">Invoice Tax:</span>
                            <span class="info-value">@sale.TotalTax.ToString("F2")</span>
                        </div>
                    </div>
                </div>
            }
        }
        else if (ViewBag.IsInitialLoad != true)
        {
            <div class="text-center p-5 text-muted border border-dashed rounded-4 bg-white">
                <i class="fas fa-search fa-3x mb-3" style="color:#eee;"></i>
                <p class="mb-0">No records found for the selected dates.</p>
            </div>
        }
    </div>

</div>

@section Scripts{
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btnShowReport = document.getElementById("btnShowReport");
        const printArea = document.getElementById("printArea");

        if (btnShowReport && printArea) {
            btnShowReport.addEventListener("click", function (e) {
                const hasResults = printArea.querySelector(".report-card") !== null;
                
                if (hasResults && btnShowReport.innerText.includes("Hide Report")) {
                    printArea.style.display = "none";
                    btnShowReport.innerText = "Show Report";
                    e.preventDefault();
                } else if (printArea.style.display === "none") {
                    printArea.style.display = "block";
                    btnShowReport.innerText = "Hide Report";
                    e.preventDefault();
                }
            });
        }
    });
</script>
}