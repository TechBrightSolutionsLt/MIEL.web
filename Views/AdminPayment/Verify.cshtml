@model MIEL.web.Models.ViewModel.VerifyPaymentVM
@{
    ViewData["Title"] = "Verifying";
    Layout = "_AdminLayout";
}
<h2>Verify  Payment</h2>

<form asp-action="Verify" method="post" id="verifyForm">
    <input type="hidden" asp-for="Id" />


    <div class="form-group">
        <label>Order Number</label>
        <input class="form-control" value="@Model.OrderNumber" readonly />
    </div>

    <div class="form-group">
        <label>Payment Mode</label>
        <input class="form-control" value="@Model.PaymentType" readonly />
    </div>

    <div class="form-group">
        <label>Total Amount</label>
        <input class="form-control" value="@Model.TotalAmount" readonly />
    </div>

    <div class="form-group">
        <label>Bank Transaction Reference</label>
        <input asp-for="BankReference" class="form-control" required />
    </div>

    <br />

    <button type="submit" class="btn btn-success">
       
        Confirm Payment
    </button>
</form>
<script src="https://cdn.jsdelivr.net/npm/emailjs-com@3/dist/email.min.js"></script>

<script>
    (function () {
        emailjs.init("9aE_1VzIvNy3xsMf8");
    })();

    document.getElementById("verifyForm").addEventListener("submit", function (e) {debugger;

        e.preventDefault(); // 🔥 STOP normal submit

        var form = this;

        var orderNumber = "@Model.OrderNumber";
        var amount = "@Model.TotalAmount";
        var paymentType = "@Model.PaymentType";
        var bankReference = document.querySelector("[name='BankReference']").value;
        var customerEmail = "@Model.Email";
        var orderDate = new Date().toLocaleDateString();
        var time = new Date().toLocaleString();
        var name = "@Model.FirstName";

        emailjs.send("service_2dg2iki", "template_ppsnis8", {
            title: "MIEL Collections",
            name: name,
            order_number: orderNumber,
            order_date: orderDate,
            amount: amount,
            payment_type: paymentType,
            bank_reference: bankReference,
            time: time,
            to_email: customerEmail
        })
        .then(function (response) {
            console.log("Email Sent!", response);

            // ✅ After email sent, submit form manually
            form.submit();
        })
        .catch(function (error) {
            console.log("Email Failed...", error);

            // Optional: still submit form even if email fails
            form.submit();
        });

    });
</script>