@model List<MIEL.web.Models.ViewModel.SalesVM>

<h4 class="mb-3">All Sales Details</h4>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Invoice No</th>
            <th>Date</th>
            <th>Payment</th>
            <th>Total</th>
            <th>Variant</th>
            <th>Batch</th>
            <th>Qty</th>
            <th>Price</th>
            <th>Discount</th>
            <th>GST</th>
            <th>Net</th>
            <th width="150">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sale in Model)
        {
            if (sale.Items != null && sale.Items.Any())
            {
                foreach (var item in sale.Items)
                {
                    <tr>

                        <td>@sale.InvoiceNo</td>
                        <td>@sale.SalesDate.ToString("dd-MM-yyyy")</td>
                        <td>@sale.PaymentType</td>
                        <td>@sale.NetAmount.ToString("0.00")</td>

                        <td>@item.varientid</td>
                        <td>@item.BatchNo</td>
                        <td>@item.Quantity</td>
                        <td>@item.SellingPrice.ToString("0.00")</td>
                        <td>@item.DiscAmount.ToString("0.00")</td>
                        <td>@item.TaxAmount.ToString("0.00")</td>
                        <td>@item.NetAmount.ToString("0.00")</td>

                        <td>

                            <a asp-action="Print"
                               asp-route-id="@sale.SalesId"
                               target="_blank"
                               class="btn btn-info btn-sm">
                                🖨 Print
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@sale.SalesId"
                               class="btn btn-warning btn-sm">
                                ✏ Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@sale.SalesId"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Are you sure you want to delete this sale?');">
                                🗑 Delete
                            </a>

                        </td>






                    </tr>
                }
            }
        }
    </tbody>

</table>
