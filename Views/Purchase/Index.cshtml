@model IEnumerable<MIEL.web.Models.ViewModel.PurchaseListVM>

@{
    ViewData["Title"] = "Purchase List";
    Layout = "_AdminLayout";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between mb-3">
        <h4>Purchase List</h4>
        <a asp-action="Create" class="btn btn-primary">+ New Purchase</a>
    </div>

    <form method="get" class="mb-3">
        <input type="text" name="search" class="form-control"
               placeholder="Search by Invoice No" />
    </form>

    <div class="card">
        <div class="card-body p-0">
            <table class="table table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Invoice No</th>
                        <th>Date</th>
                        <th>Supplier</th>
                        <th class="text-end">Total</th>
                        <th style="width:150px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.InvoiceNo</td>
                            <td>@item.InvoiceDate.ToShortDateString()</td>
                            <td>@item.SupplierName</td>
                            <td class="text-end">@item.GrandTotal.ToString("0.00")</td>
                            <td>
                                @* <a asp-action="Edit"
                                   asp-route-id="@item.PurchaseId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a> *@
                                <a asp-action="Edit"
                                   asp-route-id="@item.PurchaseId"
                                   class="btn btn-sm btn-warning"
                                   onclick="return confirm(' Do you want to edit this purchase record?')">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.PurchaseId"
                                   class="btn btn-sm btn-danger"
                                   onclick="return confirm('Delete this purchase?')">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
