@model MIEL.web.Models.ViewModel.PayIDViewModel

<div class="container mt-5">
    <div class="card shadow-lg p-4 rounded-4">

        <h3 class="mb-4 text-center text-primary">Pay Online (PayID)</h3>

        <!-- Order Info -->
        <div class="mb-3">
            <p>
                <strong>Order ID:</strong>
                <span class="badge bg-dark fs-6">@Model.OrderNumber</span>
            </p>

            <p>
                <strong>Amount:</strong>
                <span class="badge bg-success fs-6">A$ @Model.TotalAmount</span>
            </p>
        </div>

        <!-- Highlighted PayID Section -->
        <div class="p-4 mb-4 bg-light border rounded-4 text-center">

            <h5 class="text-danger mb-3">Transfer To This PayID</h5>

            <p class="fs-4 fw-bold text-primary">
                📱 @Model.PayId
            </p>

            <p class="fs-5 fw-bold text-secondary">
                📧 @Model.Email
            </p>

            <small class="text-muted">
                Please use your <strong>Order ID (@Model.OrderNumber)</strong> as payment reference.
            </small>
        </div>

        <form asp-action="OrderSuccess" method="post" class="text-center">
            <input type="hidden" name="SalesId" value="@Model.SalesId" />
            <input type="hidden" name="OrderId" value="@Model.OrderId" />
            <input type="hidden" name="PayId" value="@Model.PayId" />

            <button type="submit" class="btn btn-primary px-5 py-2 rounded-3">
                Continue
            </button>
        </form>

    </div>
</div>
