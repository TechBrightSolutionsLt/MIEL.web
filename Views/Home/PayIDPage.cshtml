@model MIEL.web.Models.ViewModel.PayIDViewModel

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm border-0">

                <!-- Header -->
                <div class="card-body text-center">

                    <h4 class="mb-3">Pay via PayID</h4>

                    <div class="mb-4">
                        <div class="text-muted">Order ID</div>
                        <div class="highlight-value text-dark">@Model.OrderNumber</div>
                    </div>

                    <div class="mb-4">
                        <div class="text-muted">Amount to Pay</div>
                        <div class="highlight-value text-dark">
                            @Model.TotalAmount.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-AU"))
                        </div>
                    </div>

                    <hr />

                    <!-- Highlight Box -->
                    <div class="highlight-box mb-4">

                        <div class="mb-3">
                            <div class="label-text">PayID (Mobile Number)</div>
                            <div class="highlight-value text-primary">
                                @Model.PayId
                            </div>
                        </div>

                        <div>
                            <div class="label-text">PayID (Email)</div>
                            <div class="highlight-value text-dark">
                                @Model.Email
                            </div>
                        </div>

                    </div>

                    <div class="text-muted mb-4">
                        Use <strong>@Model.OrderNumber</strong> as payment reference
                    </div>

                    <!-- Button -->
                    <form asp-action="OrderSuccess" method="post">

                        <input type="hidden" name="SalesId" value="@Model.SalesId" />
                        <input type="hidden" name="OrderId" value="@Model.OrderId" />
                        <input type="hidden" name="PayId" value="@Model.PayId" />

                        <button type="submit" class="btn btn-success px-4">
                            Continue
                        </button>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

<style>

    .highlight-box {
        background: #f8f9fa;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        padding: 20px;
    }

    .label-text {
        font-size: 13px;
        color: #777;
        margin-bottom: 3px;
    }

    .highlight-value {
        font-size: 22px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    .card {
        border-radius: 10px;
    }

</style>
<script src="https://cdn.jsdelivr.net/npm/emailjs-com@3/dist/email.min.js"></script>

<script>
    (function () {
        emailjs.init("9aE_1VzIvNy3xsMf8");
    })();

        document.addEventListener("DOMContentLoaded", function () {

        var orderNumber = "@Model.OrderNumber";
        var amount = "@Model.TotalAmount";
        var orderDate = new Date().toLocaleDateString();
        var customerEmail = "@Model.Email";

        console.log("Sending to:", customerEmail);

        emailjs.send("service_2dg2iki", "template_v7o06jf", {
            order_number: orderNumber,
            amount: amount,
            order_date: orderDate,
            to_email: customerEmail,
            name: "MIEL Collections",
            email: "mielcollectionss@gmail.com"
        })
        .then(function (response) {
            console.log("SUCCESS!", response);
        })
        .catch(function (error) {
            console.log("FAILED...", error);
        });

    });
</script>