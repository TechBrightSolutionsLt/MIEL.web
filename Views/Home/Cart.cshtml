@model List<MIEL.web.Models.ViewModel.CartItem>

@{
    var totalQty = Model.Sum(x => x.Quantity);
    var totalAmount = Model.Sum(x => x.Price * x.Quantity);
}

<!-- ===== CHECKOUT STEPS ===== -->
<div class="container mt-4">
    <div class="checkout-steps d-flex justify-content-between align-items-center">

        <div class="step active">
            <div class="circle">1</div>
            <div class="label">Cart</div>
        </div>

        <div class="line"></div>

        <div class="step">
            <div class="circle">2</div>
            <div class="label">Review</div>
        </div>

        <div class="line"></div>

        <div class="step">
            <div class="circle">3</div>
            <div class="label">Payment</div>
        </div>

    </div>
</div>

<div class="container py-4">
    <div class="row">

        <!-- ================= LEFT SIDE ================= -->
        <div class="col-md-8">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <h4 class="mb-4 fw-bold">My Cart (@totalQty item@(totalQty != 1 ? "s" : ""))</h4>

            @if (!Model.Any())
            {
                <div class="alert alert-warning text-center py-4">Your cart is empty</div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    var imgSrc = string.IsNullOrEmpty(item.Image)
                        ? "/images/no-image.png"
                        : (item.Image.StartsWith("/") || item.Image.StartsWith("http")
                            ? item.Image
                            : "/productimages/" + item.Image);

                    <div class="card mb-3 border-0 shadow-sm rounded-3">
                        <div class="card-body p-3">
                            <div class="row align-items-center g-3">

                                <!-- IMAGE COLUMN -->
                                <div class="col-auto">
                                    <img src="@imgSrc"
                                         alt="@item.ProductName"
                                         class="rounded border"
                                         style="width: 110px; height: 130px; object-fit: cover; display: block;"
                                         onerror="this.onerror=null;this.src='https://via.placeholder.com/110x130?text=No+Image';" />
                                </div>

                                <!-- DETAILS COLUMN -->
                                <div class="col">
                                    <h5 class="fw-bold mb-1 text-dark">@item.ProductName</h5>

                                    <p class="small mb-1 text-dark">
                                        Color: <strong class="text-dark">@item.Color</strong> &nbsp;|&nbsp;
                                        Size: <strong class="text-dark">@item.Size</strong>
                                    </p>

                                    <p class="mb-1 text-dark">
                                        Price: <strong class="text-dark">A$@item.Price.ToString("F2")</strong>
                                    </p>

                                    <p class="mb-3 text-dark">
                                        Subtotal: <strong class="text-dark">A$@((item.Price * item.Quantity).ToString("F2"))</strong>
                                    </p>

                                    <!-- QUANTITY & ACTIONS -->
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="d-flex align-items-center border rounded px-1 py-1" style="background:#f8f9fa;">
                                            <button class="btn btn-sm btn-light border-0 px-2 fw-bold"
                                                    type="button"
                                                    onclick="updateQty(@item.VariantId, -1)">
                                                −
                                            </button>
                                            <span class="px-3 fw-bold text-dark">@item.Quantity</span>
                                            <button class="btn btn-sm btn-light border-0 px-2 fw-bold"
                                                    type="button"
                                                    onclick="updateQty(@item.VariantId, 1)">
                                                +
                                            </button>
                                        </div>

                                        <button class="btn btn-sm btn-outline-danger px-3 rounded-pill"
                                                onclick="removeItem(@item.VariantId)">
                                            Remove
                                        </button>
                                    </div>

                                </div>

                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- ================= RIGHT SIDE ================= -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">

                    <h5 class="fw-bold">PRICE DETAILS</h5>
                    <hr />

                    <p class="d-flex justify-content-between mb-2">
                        <span>Price (@totalQty item@(totalQty != 1 ? "s" : ""))</span>
                        <span class="fw-bold">A$@totalAmount.ToString("F2")</span>
                    </p>

                    <p class="d-flex justify-content-between mb-2">
                        <span>Delivery Charges</span>
                        <span class="text-success fw-bold">FREE</span>
                    </p>

                    <hr />

                    <h6 class="d-flex justify-content-between fw-bold fs-5">
                        <span>Total Amount</span>
                        <span class="text-danger">A$@totalAmount.ToString("F2")</span>
                    </h6>

                    <button class="btn btn-warning w-100 mt-3 fw-bold py-2 shadow-sm"
                            onclick="goToReview()">
                        PLACE ORDER
                    </button>

                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .checkout-steps {
        position: relative;
        margin-bottom: 30px;
    }

    .step {
        text-align: center;
        position: relative;
        z-index: 2;
    }

    .circle {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: #ddd;
        line-height: 35px;
        font-weight: bold;
        margin: auto;
    }

    .label {
        font-size: 14px;
        margin-top: 5px;
    }

    .line {
        flex: 1;
        height: 3px;
        background: #ddd;
        margin: 0 10px;
    }

    /* ACTIVE STEP */
    .step.active .circle {
        background: #f59e0b;
        color: #fff;
    }

    .step.active .label {
        font-weight: bold;
        color: #f59e0b;
    }
</style>

<script>
    function goToReview() {

        var isLoggedIn = '@(Context.Session.GetString("CustomerId") != null ? "true" : "false")';

        if (isLoggedIn === "false") {

            alert("Please login to continue");

            window.location.href = '/Account/Profile';

            return;
        }

        window.location.href = '/Home/ReviewOrder';
    }
</script>

<script>
    function updateQty(variantId, change) {

        fetch('/Home/UpdateCartQty', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                variantId: variantId,
                change: change
            })
        })
        .then(res => res.json())
        .then(data => {

            if (!data.success) {
                alert(data.message);
                return;
            }

            location.reload();
        });
    }

    function removeItem(variantId) {

        if (!confirm("Remove this item?"))
            return;

        fetch('/Home/RemoveCartItem', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                variantId: variantId
            })
        })
        .then(res => res.json())
        .then(data => {

            if (!data.success) {
                alert(data.message);
                return;
            }

            location.reload();
        });
    }
</script>
