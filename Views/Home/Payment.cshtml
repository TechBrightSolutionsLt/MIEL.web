@using MIEL.web.Models.ViewModel
@model PaymentVM

<div class="container mt-5 mb-5">
    <!-- CHECKOUT STEPS -->
    <div class="container mt-4">
        <div class="checkout-steps d-flex justify-content-between align-items-center">

            <!-- CART (Completed) -->
            <div class="step completed">
                <div class="circle">✔</div>
                <div class="label">Cart</div>
            </div>

            <div class="line active-line"></div>

            <!-- REVIEW (Completed) -->
            <div class="step completed">
                <div class="circle">✔</div>
                <div class="label">Review</div>
            </div>

            <div class="line active-line"></div>

            <!-- PAYMENT (Active) -->
            <div class="step active">
                <div class="circle">3</div>
                <div class="label">Payment</div>
            </div>

        </div>
    </div>


    <div class="row">

        <!-- LEFT SIDE : PAYMENT OPTIONS -->
        <div class="col-md-7">

            <div class="card shadow-sm p-4">

                <h4 class="mb-4">Select Payment Method</h4>

                <!-- COD -->
                <div class="payment-option mb-3 p-3"
                     onclick="payCOD(@Model.SalesId)">

                    <div class="form-check">
                        <input class="form-check-input"
                               type="radio"
                               name="paymentOption">

                        <label class="form-check-label fw-bold">
                            Cash On Delivery
                        </label>
                    </div>

                    <small class="text-muted">
                        Pay when your order is delivered
                    </small>

                </div>

                <!-- ONLINE -->
                <div class="payment-option p-3"
                     onclick="payOnline(@Model.SalesId)">

                    <div class="form-check">
                        <input class="form-check-input"
                               type="radio"
                               name="paymentOption">

                        <label class="form-check-label fw-bold">
                            Pay Online (PayId)
                        </label>
                    </div>

                    <small class="text-muted">
                        Secure payment via PayId
                    </small>

                </div>

            </div>

        </div>


        <!-- RIGHT SIDE : ORDER SUMMARY -->
        <div class="col-md-5">

            <div class="card shadow-sm p-4">

                <h5 class="mb-3">Order Summary</h5>

                <p class="text-muted">
                    Invoice: @Model.InvoiceNo
                </p>

                <hr />

                @foreach (var item in Model.Items)
                {
                    <div class="d-flex justify-content-between mb-2">

                        <div>
                            <strong>@item.ProductName</strong><br />
                            <small class="text-muted">Qty: @item.Quantity</small>
                        </div>

                        <div class="text-end">
                            <strong>₹@(item.Price * item.Quantity)</strong>
                            @if (item.Quantity > 1)
                            {
                                <br /><small class="text-muted">(₹@item.Price each)</small>
                            }
                        </div>

                    </div>
                }

                <hr />

                <div class="d-flex justify-content-between">
                    <span>Subtotal</span>
                    <span>₹@Model.TotalAmount</span>
                </div>

                <div class="d-flex justify-content-between">
                    <span>Shipping</span>
                    <span class="text-success">FREE</span>
                </div>

                <hr />

                <div class="d-flex justify-content-between fw-bold fs-5">
                    <span>Total</span>
                    <span class="text-danger">
                        ₹@Model.TotalAmount
                    </span>
                </div>

            </div>

        </div>

    </div>

</div>
<style>

    .payment-option {
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
    }

        .payment-option:hover {
            border-color: #f59e0b;
            background-color: #fffaf0;
        }

    .card {
        border-radius: 10px;
    }

    .checkout-steps {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        font-size: 14px;
        color: #999;
    }

    .circle {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background-color: #e5e5e5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .line {
        width: 60px;
        height: 3px;
        background-color: #e5e5e5;
    }

        .step.completed .circle,
        .line.completed {
            background-color: #198754;
            color: white;
        }

        .step.active .circle,
        .line.active {
            background-color: #0d6efd;
            color: white;
        }

    .step.completed span {
        color: #198754;
    }

    .step.active span {
        color: #0d6efd;
        font-weight: 600;
    }


</style>


<script>
    function payCOD(salesId)
    {
        window.location.href = '/Home/ConfirmCOD?salesId=' + salesId;
    }

    function payOnline(salesId)
    {
        window.location.href = '/Home/ConfirmPayID?salesId=' + salesId;
    }
</script>

