@using MIEL.web.Models.ViewModel
@model PaymentVM

<div class="container mt-5 mb-5">

    <div class="row">

        <!-- LEFT SIDE : PAYMENT OPTIONS -->
        <div class="col-md-7">

            <div class="card shadow-sm p-4">

                <h4 class="mb-4">Select Payment Method</h4>

                <!-- COD -->
                <div class="payment-option mb-3 p-3"
                     onclick="payCOD(@Model.SalesId)">

                    <div class="form-check">
                        <input class="form-check-input"
                               type="radio"
                               name="paymentOption">

                        <label class="form-check-label fw-bold">
                            Cash On Delivery
                        </label>
                    </div>

                    <small class="text-muted">
                        Pay when your order is delivered
                    </small>

                </div>

                <!-- ONLINE -->
                <div class="payment-option p-3"
                     onclick="payOnline(@Model.SalesId)">

                    <div class="form-check">
                        <input class="form-check-input"
                               type="radio"
                               name="paymentOption">

                        <label class="form-check-label fw-bold">
                            Pay Online (UPI / Card / NetBanking)
                        </label>
                    </div>

                    <small class="text-muted">
                        Secure payment via UPI, Debit/Credit Card
                    </small>

                </div>

            </div>

        </div>


        <!-- RIGHT SIDE : ORDER SUMMARY -->
        <div class="col-md-5">

            <div class="card shadow-sm p-4">

                <h5 class="mb-3">Order Summary</h5>

                <p class="text-muted">
                    Invoice: @Model.InvoiceNo
                </p>

                <hr />

                @foreach (var item in Model.Items)
                {
                    <div class="d-flex justify-content-between mb-2">

                        <div>
                            <strong>@item.ProductName</strong><br />
                            <small>Qty: @item.Quantity</small>
                        </div>

                        <div class="text-end">
                            ₹@item.Price <br />
                            <strong>
                                ₹@(item.Price* item.Quantity)
                            </strong>
                        </div>

                    </div>
                }

                <hr />

                <div class="d-flex justify-content-between">
                    <span>Subtotal</span>
                    <span>₹@Model.TotalAmount</span>
                </div>

                <div class="d-flex justify-content-between">
                    <span>Shipping</span>
                    <span class="text-success">FREE</span>
                </div>

                <hr />

                <div class="d-flex justify-content-between fw-bold fs-5">
                    <span>Total</span>
                    <span class="text-danger">
                        ₹@Model.TotalAmount
                    </span>
                </div>

            </div>

        </div>

    </div>

</div>
<style>

    .payment-option {
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
    }

        .payment-option:hover {
            border-color: #f59e0b;
            background-color: #fffaf0;
        }

    .card {
        border-radius: 10px;
    }

</style>


<script>
    function payCOD(salesId)
    {
        window.location.href = '/Home/ConfirmCOD?salesId=' + salesId;
    }

    function payOnline(salesId)
    {
        window.location.href = '/Home/ConfirmPayID?salesId=' + salesId;
    }
</script>

