@using MIEL.web.Models.EntityModels
@model SalesMaster

<div class="container mt-5 text-center">

    <div class="card p-5 shadow-sm">

        <h2 class="text-success">
            ✔ Order Placed Successfully!
        </h2>

        <p class="mt-3">
            Invoice: <strong>@Model.InvoiceNo</strong>
        </p>

        <p>
            Payment Method:
            <strong>
                @(Model.PaymentType == "Cash" ? "Cash On Delivery" :
                                Model.PaymentType == "PayID" ? "Pay Online" : "Pending")
            </strong>
        </p>

        <a href="/Home/Index"
           class="btn btn-primary mt-3">
            Continue Shopping
        </a>

    </div>

</div>
