@model MIEL.web.Models.ViewModel.PayIDViewModel
<div class="container mt-5 text-center">

    <div class="card p-5 shadow-sm">

        <h2 class="text-success">
            ✔ Order Placed Successfully!
        </h2>

        <p class="mt-3">
            Order ID: <strong>@Model.OrderNumber</strong>
        </p>

        <p>
            Payment Method:
            <strong>
                @(Model.PaymentStatus == "NotPaid" ? "Cash On Delivery / PayID" : "Paid")
            </strong>
        </p>

        <p>
            Total Amount: <strong>₹@Model.TotalAmount</strong>
        </p>

        <a href="/Home/Index"
           class="btn btn-primary mt-3">
            Continue Shopping
        </a>

    </div>

</div>
<script src="https://cdn.jsdelivr.net/npm/emailjs-com@3/dist/email.min.js"></script>

<script>
    (function () {
        emailjs.init("9aE_1VzIvNy3xsMf8");
    })();

     document.addEventListener("DOMContentLoaded", function () {

        var orderNumber = "@Model.OrderNumber";
        var amount = "@Model.TotalAmount";
        var orderDate = new Date().toLocaleDateString();
        var customerEmail = "@Model.CustomerEmail";
        var items = "@Model.ItemsSummary";
        var customerName = "@Model.CustomerName";
        // ✅ 1. Existing Business Email (DO NOT TOUCH)
        emailjs.send("service_2dg2iki", "template_v7o06jf", {
            order_number: orderNumber,
            amount: amount,
            order_date: orderDate,
            to_email: "mielcollectionss@gmail.com",
            name: "MIEL Collections"
        });

        // ✅ 2. NEW Customer Email (Extra Added)
        emailjs.send("service_2dg2iki", "template_icpqwij", {
            order_number: orderNumber,
            amount: amount,
            order_date: orderDate,
            items: items,
            customer_name: customerName,
            to_email: customerEmail
        });

    });
</script>