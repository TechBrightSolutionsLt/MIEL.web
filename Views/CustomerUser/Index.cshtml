@model IEnumerable<MIEL.web.Models.EntityModels.userModel>
@{
    ViewData["Title"] = "User List";
}

<h2>User List</h2>
<p>
    <a class="btn btn-primary" asp-action="Create">Add New User</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Mobile</th>
            <th>City</th>
            <th>Created Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@user.Email</td>
                <td>@user.MobileNumber</td>
                <td>@user.City</td>
                <td>@user.CreatedDate.ToString("dd-MM-yyyy")</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Edit" asp-route-id="@user.CustomerId">Edit</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@user.CustomerId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
