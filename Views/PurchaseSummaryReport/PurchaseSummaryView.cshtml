@model List<MIEL.web.Models.ViewModel.PurchaseSummaryVM>
@{
    ViewData["Title"] = "Purchase Summary Report";
    Layout = "_AdminLayout";
}

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0 fw-bold">Purchase Summary Report</h4>
    </div>

    <div class="card-body">
        <form method="get" asp-controller="PurchaseSummary" asp-action="PurchaseSummaryView">
            <div class="row">
                <div class="col-md-3">
                    <label class="fw-bold">From Date</label>
                    <input type="date" name="FromDate" value="@ViewBag.FromDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="fw-bold">To Date</label>
                    <input type="date" name="ToDate" value="@ViewBag.ToDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="fw-bold">Invoice No</label>
                    <input type="text" name="InvoiceNo" value="@ViewBag.InvoiceNo" class="form-control" />
                </div>
            </div>

            <br />

            <button type="submit" class="btn btn-primary">
                Search
            </button>

            @if (Model != null)
            {
                <div class="text-center mt-4">
                    <h2 style="letter-spacing:2px; font-weight:bold;">
                        PURCHASE SUMMARY REPORT
                    </h2>
                    <p>Generated on @DateTime.Now.ToString("dd MMMM yyyy")</p>
                    <hr style="width:150px; margin:auto; border:2px solid #c49a6c;" />
                </div>

                <div class="card mt-3">
                    

                    <div class="card-body">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Invoice No</th>
                                    <th>Purchase Date</th>
                                    <th>GST</th>
                                    <th>Net Amount</th>
                                    <th>Total Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.InvoiceNo</td>
                                        <td>@item.InvoiceDate.ToString("dd-MM-yyyy")</td>
                                        <td>@item.GstAmount</td>
                                        <td>@item.NetAmount</td>
                                        <td>@item.TotalAmount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </form>
    </div>
</div>