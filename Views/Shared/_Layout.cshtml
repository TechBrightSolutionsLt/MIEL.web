        /* Subcategory horizontal bar */


        .horizontal-subcats {
            list-style: none;
            display: flex;
            justify-content: flex-start;
            align-items: center;
            gap: 40px;
            padding: 14px 0;
            margin: 0;
        }

            .horizontal-subcats li a {
                text-decoration: none;
                font-size: 14px;
                font-weight: 600;
                letter-spacing: 1px;
                color: #555;
                transition: 0.3s ease;
                position: relative;
            }

                /* Hover effect */
                .horizontal-subcats li a:hover {
                    color: #b68d40;
                }

                /* Active underline animation */
                .horizontal-subcats li a::after {
                    content: "";
                    position: absolute;
                    width: 0%;
                    height: 2px;
                    bottom: -6px;
                    left: 0;
                    background-color: #b68d40;
                    transition: width 0.3s ease;
                }

                .horizontal-subcats li a:hover::after {
                    width: 100%;
                }
.navbar {
    background: #ffffff !important;
    border-top: 1px solid #eee;
    border-bottom: 1px solid #eee;
}

.main-category-menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
}

.main-category-menu li {
    margin: 0 22px;
    position: relative;
}

.main-category-menu li a {
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1.2px;
    color: #000;
    padding: 18px 0;
    display: inline-block;
    transition: all 0.3s ease;
}
        /* Selected Category Title */
        #selectedCategoryTitle {
            font-size: 24px;
            font-weight: 700;
            letter-spacing: 1px;
            color: #000;
            margin-bottom: 5px;
        }

      
        /* Active main category */
        #layoutMainCategories a.main-link.active {
            color: #b68d40;
            border-bottom: 2px solid #b68d40;
        }

        /* Profile Icon Special Style */
        .profile-icon {
            font-size: 18px;
            margin-left: 20px;
            transition: 0.3s ease;
        }

            .profile-icon:hover {
                color: #b68d40;
                transform: scale(1.1);
            }
/* Hover underline animation */
        #layoutMainCategories {
            list-style: none;
            display: flex;
            justify-content: flex-start; /* LEFT ALIGN */
            gap: 40px;
            margin: 0;
            padding: 10px 0;
        }

            #layoutMainCategories li {
                position: relative;
            }

            #layoutMainCategories a.main-link {
                text-decoration: none;
                font-size: 26px;
                font-weight: 600;
                letter-spacing: -1px;
                color: #000;
                transition: 0.3s;
            }

                #layoutMainCategories a.main-link:hover {
                    color: #b68d40;
                }
        /* ============================= */
        /* PROFESSIONAL HEADER STYLE */
        /* ============================= */

        .header-main-categories {
            list-style: none;
            display: flex;
            gap: 35px;
            margin: 0;
            padding: 0;
        }

            .header-main-categories li a {
                text-decoration: none;
                font-size: 16px; /* Increased size */
                font-weight: 700; /* Bold */
                letter-spacing: 1.5px;
                color: #111;
                transition: 0.3s ease;
                position: relative;
            }

                /* Hover */
                .header-main-categories li a:hover {
                    color: #b68d40;
                }

                /* Active Highlight */
                .header-main-categories li a.active {
                    color: #b68d40;
                }

                /* Underline Animation */
                .header-main-categories li a::after {
                    content: "";
                    position: absolute;
                    width: 0%;
                    height: 2px;
                    bottom: -8px;
                    left: 0;
                    background-color: #b68d40;
                    transition: width 0.3s ease;
                }

                .header-main-categories li a:hover::after,
                .header-main-categories li a.active::after {
                    width: 100%;
                }

        /* Search */
        .search-box {
            position: relative;
        }

            .search-box input {
                border: none;
                border-bottom: 1px solid #ddd;
                outline: none;
                font-size: 13px;
                padding-right: 25px;
            }

            .search-box i {
                position: absolute;
                right: 0;
                top: 3px;
                font-size: 13px;
                color: #888;
            }

        .bg-secondary {
