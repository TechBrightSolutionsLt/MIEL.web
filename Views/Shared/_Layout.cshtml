            text-decoration: none;
        }

            .icon-btn span {
                position: absolute;
                top: -8px;
                right: -10px;
                font-size: 11px;
                background: #b68d40;
                color: white;
                border-radius: 50%;
                padding: 2px 6px;
            }
    </style>
    @RenderSection("Scripts", required: false)
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            fetch('/Home/GetCartCount')
                .then(res => res.json())
                .then(data => {
                    const cartCount = document.getElementById("cartCount");
                    if (cartCount) {
                        cartCount.textContent = data.count;
                    }
                });
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const container = document.getElementById("layoutMainCategories");
            if (!container) return;

            // Load Main Categories
            fetch('/Home/GetMainCategories')
                .then(res => res.json())
                .then(data => {

                    container.innerHTML = "";

                    data.forEach(cat => {
                        container.innerHTML += `
                            <li class="position-relative main-li">
                                <a href="javascript:void(0)"
                                   class="main-link"
                                   data-id="${cat.mainCategoryId}">
                                   ${cat.mainCategoryName.toUpperCase()}
                                </a>
                             
                            </li>
                        `;
                    });

                });

            // CLICK EVENT (instead of hover)
            container.addEventListener("click", function (e) {

            if (e.target.classList.contains("main-link")) {

                const mainLink = e.target;
                const categoryId = mainLink.dataset.id;
                const categoryName = mainLink.textContent;

                const titleBar = document.getElementById("selectedCategoryBar");
                const title = document.getElementById("selectedCategoryTitle");
                const subBar = document.getElementById("subCategoryBar");
                const subList = document.getElementById("horizontalSubCategories");

                // Remove active class from all
                document.querySelectorAll(".main-link")
                    .forEach(link => link.classList.remove("active"));

                // Add active class to selected
                mainLink.classList.add("active");

                // Show category title
                title.textContent = categoryName;
                titleBar.style.display = "block";

                // Load subcategories
                fetch('/Home/GetSubCategories?categoryId=' + categoryId)
                    .then(res => res.json())
                    .then(data => {

                        subList.innerHTML = "";

                        if (data.length === 0) {
                            subBar.classList.add("d-none");
                            return;
                        }

                        data.forEach(sub => {
                            subList.innerHTML += `
                                <li>
                                    <a href="/Home/CategoryProducts?categoryId=${sub.subCategoryId}">
                                        ${sub.subCategoryName}
                                    </a>
                                </li>
                            `;
                        });

                        subBar.classList.remove("d-none");
                    });
            }
        });

            // Optional: click outside to close
            document.addEventListener("click", function (e) {
                if (!container.contains(e.target)) {
                    document.querySelectorAll(".subcat-container")
                        .forEach(el => el.classList.add("d-none"));
                }
            });

        });
    </script>

</body>
</html>
